# Frontend environment variables example
# Use HTTPS base URL of the backend API (root, not /docs).
# This is the single source of truth for the frontend → backend base URL.
# Order of precedence in code:
# 1) window.__BACKEND_URL__ (runtime injected, if present)
# 2) FRONTEND_BACKEND_BASE_URL
# 3) REACT_APP_BACKEND_URL (backward compatibility)
# 4) Default fallback set in src/config/api.ts

# PUBLIC_INTERFACE
# FRONTEND_BACKEND_BASE_URL
# Base URL for the backend API. Do NOT include a trailing path like /docs.
# Example below points to the running backend container for this environment.
FRONTEND_BACKEND_BASE_URL=https://vscode-internal-13141-beta.beta01.cloud.kavia.ai:3001

# Backward compatibility variable (optional). Prefer FRONTEND_BACKEND_BASE_URL above.
# REACT_APP_BACKEND_URL=https://vscode-internal-13141-beta.beta01.cloud.kavia.ai:3001
